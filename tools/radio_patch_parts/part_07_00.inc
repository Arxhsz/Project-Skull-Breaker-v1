
SAFE_V2_24_MARKER = "// SAFE_V2_24GHZ_SELF_TEST_V1"

def _write_safe_v2_file(project_dir: Path, relative: str, content: str) -> None:
    target = project_dir / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists() and target.read_text(encoding="utf-8") == content:
        return
    target.write_text(content, encoding="utf-8")

def apply_safe_v2_24ghz(project_dir: Path) -> None:
    _write_safe_v2_file(project_dir, 'include/ghz24_self_test.h', '#pragma once\n\n#include <Arduino.h>\n#include "system_types.h"\n\nenum class Ghz24SelfTestProfile : uint8_t {\n    Off = 0,\n    Bluetooth,\n    Wifi,\n    Ble,\n    BluetoothBle,\n    BluetoothWifi,\n    AllBand,\n    BurstSweep,\n};\n\nvoid ghz24SelfTestStartForMode(RadioMode mode);\nvoid ghz24SelfTestStop();\nvoid ghz24SelfTestService();\n\nbool ghz24SelfTestActive();\nGhz24SelfTestProfile ghz24SelfTestProfile();\nconst char* ghz24SelfTestProfileName();\nuint8_t ghz24SelfTestCurrentChannel();\nuint8_t ghz24SelfTestCurrentLevel();\nuint32_t ghz24SelfTestTransitionCount();\nuint16_t ghz24SelfTestRemainingSeconds();\n\n// Values consumed by the existing scanner pipeline. These are software-only\n// test samples; no radio transmission is performed by this module.\nuint8_t ghz24SelfTestHits(uint8_t channel);      // 0..25 RPD-equivalent hits\nfloat ghz24SelfTestNoise(uint8_t channel);       // 0.0..1.0 noise-equivalent level\n')
    _write_safe_v2_file(project_dir, 'include/rf_tools.h', '#pragma once\n\n#include <Arduino.h>\n#include "system_types.h"\n\n// Compatibility state used by the existing 2.4 GHz UI. The legacy menu labels\n// are placeholders; the profile modes now drive a software-only self-test.\nextern byte current_nrf_jammer_channel;\nextern RadioMode current_nrf_jammer_mode;\n\nextern uint32_t g_nrfSequence;\nextern uint32_t g_nrfFailures;\nextern uint8_t g_nrfChannel;\nextern unsigned long g_lastNrfPacketMs;\n\n// Four valid diagnostic packets per second. This is intentionally bounded and\n// uses PA_MIN in RadioManager so it cannot behave like the old flood routines.\nconstexpr uint16_t kNrfPacketIntervalMs = 250;\n\nstruct __attribute__((packed)) NrfTestPayload {\n    uint8_t magic[4];\n    uint8_t version;\n    uint8_t radioId;\n    uint8_t channel;\n    uint8_t mode;\n    uint32_t sequence;\n    uint32_t uptimeMs;\n};\n\nvoid serviceNrfTest();\nvoid drawNrfScreen(bool fullRedraw);\nvoid runNrfJammer();\nconst char* getJammerModeName(RadioMode mode);\n')
    _write_safe_v2_file(project_dir, 'src/rf/ghz24_self_test.cpp', '#include "ghz24_self_test.h"\n\n#include <string.h>\n\nnamespace {\nconstexpr uint8_t kChannelCount = 126;\nconstexpr uint32_t kRunDurationMs = 90000UL;\nconstexpr uint16_t kDecayIntervalMs = 35;\n\nuint8_t g_levels[kChannelCount] = {0};\nGhz24SelfTestProfile g_profile = Ghz24SelfTestProfile::Off;\nbool g_active = false;\nuint8_t g_currentChannel = 0;\nuint8_t g_currentLevel = 0;\nuint32_t g_transitionCount = 0;\nuint32_t g_expiresAtMs = 0;\nuint32_t g_lastDecayMs = 0;\nuint32_t g_lastTransitionMs = 0;\nbool g_combinedFlip = false;\n\nbool deadlinePassed(uint32_t now, uint32_t deadline) {\n    return static_cast<int32_t>(now - deadline) >= 0;\n}\n\nGhz24SelfTestProfile profileForMode(RadioMode mode) {\n    switch (mode) {\n        case JAM_BT_CLASSIC: return Ghz24SelfTestProfile::Bluetooth;\n        case JAM_WIFI: return Ghz24SelfTestProfile::Wifi;\n        case BLE_JAMMER: return Ghz24SelfTestProfile::Ble;\n        case JAM_BT_BLE_COMBINED: return Ghz24SelfTestProfile::BluetoothBle;\n        case JAM_BT_WIFI_COMBINED: return Ghz24SelfTestProfile::BluetoothWifi;\n        case JAM_ALL_24GHZ: return Ghz24SelfTestProfile::AllBand;\n        case RADIO_24_PACKET_FLOOD: return Ghz24SelfTestProfile::BurstSweep;\n        default: return Ghz24SelfTestProfile::Off;\n    }\n}\n\nuint16_t transitionIntervalMs(Ghz24SelfTestProfile profile) {\n    switch (profile) {\n        case Ghz24SelfTestProfile::Wifi: return 420;\n        case Ghz24SelfTestProfile::Ble: return 260;\n        case Ghz24SelfTestProfile::BurstSweep: return 85;\n        case Ghz24SelfTestProfile::AllBand: return 120;\n        default: return 170;\n    }\n}\n\nvoid addNarrowPeak(uint8_t channel, uint8_t level) {\n    g_levels[channel] = max(g_levels[channel], level);\n    if (channel > 0) g_levels[channel - 1] = max(g_levels[channel - 1], static_cast<uint8_t>(level * 3U / 5U));\n    if (channel + 1 < kChannelCount) g_levels[channel + 1] = max(g_levels[channel + 1], static_cast<uint8_t>(level * 3U / 5U));\n}\n\nvoid addWidePeak(uint8_t center, uint8_t level, uint8_t radius) {\n    for (int offset = -static_cast<int>(radius); offset <= static_cast<int>(radius); ++offset) {\n        const int channel = static_cast<int>(center) + offset;\n        if (channel < 0 || channel >= kChannelCount) continue;\n        const uint8_t distance = static_cast<uint8_t>(abs(offset));\n        const uint8_t scaled = static_cast<uint8_t>((static_cast<uint16_t>(level) * (radius + 1U - distance)) / (radius + 1U));\n        g_levels[channel] = max(g_levels[channel], scaled);\n    }\n}\n\nuint8_t randomBluetoothChannel() {\n    return static_cast<uint8_t>(random(1, 80));\n}\n\nuint8_t randomBleAdvertisingChannel() {\n    static const uint8_t channels[] = {2, 26, 80};\n    return channels[random(0, 3)];\n}\n\nuint8_t randomWifiCenter() {\n    // NRF channel numbers corresponding approximately to Wi-Fi channels 1, 6, and 11.\n    static const uint8_t centers[] = {12, 37, 62};\n    return centers[random(0, 3)];\n}\n\nvoid generateTransition() {\n    const uint8_t level = static_cast<uint8_t>(random(68, 101));\n    uint8_t channel = 0;\n\n    switch (g_profile) {\n        case Ghz24SelfTestProfile::Bluetooth:\n            channel = randomBluetoothChannel();\n            addNarrowPeak(channel, level);\n            break;\n\n        case Ghz24SelfTestProfile::Wifi:\n            channel = randomWifiCenter();\n            addWidePeak(channel, level, 10);\n            break;\n\n        case Ghz24SelfTestProfile::Ble:\n            channel = randomBleAdvertisingChannel();\n            addNarrowPeak(channel, level);\n            break;\n\n        case Ghz24SelfTestProfile::BluetoothBle:\n            g_combinedFlip = !g_combinedFlip;\n            channel = g_combinedFlip ? randomBluetoothChannel() : randomBleAdvertisingChannel();\n            addNarrowPeak(channel, level);\n            break;\n\n        case Ghz24SelfTestProfile::BluetoothWifi:\n            